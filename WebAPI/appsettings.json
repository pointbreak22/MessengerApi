{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AllowedOrigins": [],

  // Кто получает роль SuperAdmin. Роль проставляется в БД при входе этой учётной
  // записи (см. EnsureUserCommandHandler), поэтому менять что-то в базе руками не
  // нужно — достаточно изменить значение здесь. Пустая строка означает, что
  // суперадмина нет вовсе.
  "Admin": {
    "SuperAdminEmail": "zbrozhek13@gmail.com"
  },

  // Автомодерация мата в никах, названиях чатов и сообщениях. Нарушение отклоняет
  // действие и приходит письмом-предупреждением; на MaxStrikes-е — бан.
  // Предупреждения сгорают после StrikeDecayDays дней без нарушений.
  // Автобан IP: если за StrikeDecayDays дней с одного IP страйки получили
  // IpBanUserThreshold разных аккаунтов, IP блокируется на IpBanDays дней
  // (0 — бессрочно; IpBanUserThreshold = 0 — автобан IP выключен).
  "Moderation": {
    "Enabled": true,
    "MaxStrikes": 3,
    "StrikeDecayDays": 30,
    "IpBanUserThreshold": 3,
    "IpBanDays": 7
  },

  // Azure Communication Services Email. ConnectionString — секрет: в
  // appsettings.Secrets.json / Key Vault (Email--ConnectionString). Пока не задано,
  // письма только пишутся в лог.
  "Email": {
    "ConnectionString": "",
    "SenderAddress": ""
  },

  // Уведомления админу в Telegram о каждом нарушении автомодерации: кто, почта,
  // что пытался сделать, итог. Тот же бот, что у PointCraft. BotToken — секрет
  // (appsettings.Secrets.json / Key Vault TelegramBot--BotToken).
  "TelegramBot": {
    "Enabled": false,
    "BotToken": "",
    "ChatIds": []
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AzureAd": {
    "Instance": "",
    "TenantId": "",
    "ClientId": ""
  },

  "Redis": {
    "Configuration": ""
  },

  "Azure": {
    "SignalR": {
      "ConnectionString": ""
    },
    "Blob": {
      "ConnectionString": ""
    }
  },

  "KeyVault": {
    "Endpoint": ""
  },

  "ApplicationInsights": {
    "InstrumentationKey": ""
  },

  "GroupCallProviders": {
    "LiveKit": {
      "Url": "",
      "ApiKey": "",
      "ApiSecret": ""
    },
    "Jitsi": {
      "Domain": "",
      "AppId": "",
      "ApiKey": "",
      "PrivateKey": ""
    },
    "Janus": {
      "GatewayUrl": ""
    }
  }
}


