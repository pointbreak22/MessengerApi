#!/usr/bin/env pwsh
<# Pre-commit hook: regenerate CODEMAP.json and stage changes. #>
try {
	$repoRoot = (& git rev-parse --show-toplevel).Trim()
	$script = Join-Path $repoRoot 'scripts\Generate-CodeMap.ps1'
	if (Test-Path $script) {
		pwsh -NoProfile -ExecutionPolicy Bypass -File $script
		git add "$repoRoot\CODEMAP.json" | Out-Null
	}
} catch {
	Write-Error "Pre-commit hook failed: $_"
	exit 1
}
exit 0
